{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=familytrip.db"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "FamilyTripAPI",
    "Audience": "FamilyTripClient",
    "ExpiresInMinutes": 60
  },
  "AI": {
    "Enabled": true,
    "Provider": "Anthropic",
    "Model": "claude-haiku-4-5",
    "MaxOutputTokens": 1500,
    "MaxCandidates": 6,
    "RequestTimeoutSeconds": 30
  },
  "Integrations": {
    "OpenWeatherMap": {
      "BaseUrl": "https://api.openweathermap.org/",
      "CacheTtlMinutes": 60
    },
    "GoogleMaps": {
      "BaseUrl": "https://maps.googleapis.com/",
      "CacheTtlDays": 30
    },
    "Duffel": {
      "BaseUrl": "https://api.duffel.com/",
      "ApiVersion": "v2",
      "CacheTtlMinutes": 15
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/familytrip-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
